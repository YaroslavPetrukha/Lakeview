            "key": "html",
            "value": "<script>\n/* Meta Pixel Lead - deduplicated with the server-side CAPI Lead via the shared eventID.\n   Signals completion to GTM after a short delay so the pixel request leaves before the\n   page redirects to /thanks.html (the page waits for eventCallback, max 1.5 s). */\n(function(){\n  var gtm = window.google_tag_manager && window.google_tag_manager[{{Container ID}}];\n  var htmlId = {{HTML ID}};\n  function done(ok){ if (gtm) { ok ? gtm.onHtmlSuccess(htmlId) : gtm.onHtmlFailure(htmlId); } }\n  try {\n    var eventId = {{DLV - event_id}};\n    if (typeof window.fbq !== 'function' || !eventId) { done(false); return; }\n    window.fbq('trackSingle', {{Const - Meta Pixel ID}}, 'Lead',\n      { content_name: {{DLV - form_place}} || '' },\n      { eventID: String(eventId) });\n    setTimeout(function(){ done(true); }, 300);\n  } catch (e) { done(false); }\n})();\n</script>"
