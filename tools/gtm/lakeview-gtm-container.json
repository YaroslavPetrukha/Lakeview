            "value": "<script>\n/* Meta Pixel base: init + PageView. Guarded so a second firing (or a hard-coded pixel added later) never re-inits. */\n(function(){\n  var PIXEL_ID = {{Const - Meta Pixel ID}};\n  if (window.__lvFbPixelInit) return;\n  window.__lvFbPixelInit = true;\n  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?\n  n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;\n  n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;\n  t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,\n  document,'script','https://connect.facebook.net/en_US/fbevents.js');\n  /* No automatic events (button-click / page-metadata scraping) - only the events defined in GTM. Must precede init. */\n  fbq('set', 'autoConfig', false, PIXEL_ID);\n  fbq('init', PIXEL_ID);\n  fbq('trackSingle', PIXEL_ID, 'PageView');\n})();\n</script>"
