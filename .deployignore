# Files NOT uploaded to production via deploy.sh
# (rsync --exclude-from format)

# Version control
.git/
.github/
.gitignore
.gitattributes

# OS / editors
.DS_Store
.vscode/
.idea/
.claude/

# Source materials (not for serving)
assets/
Рендера/
Планування/
червень/
# Unreleased concept work (WebGL hero / 3D tour) — lives on its own branch, never served
concept/
# Client source drops: raw architect PDFs, BIMx model, WhatsApp photos — internal only.
# WARNING: macOS ships openrsync, which SPLITS EXCLUDE PATTERNS ON WHITESPACE — a literal
# "новий концепт/" is parsed as two patterns ("новий" + "концепт") and silently matches
# nothing. Any folder name containing a space MUST be excluded via a space-free wildcard.
*концепт*
# Monthly photo source drops (Cyrillic-named originals at repo root, pre-processing)
/*-source/
/*_source/

# Internal planning / docs (not for serving)
# Use leading slash to anchor at deploy root only — without it, `plans/`
# would also match `img/plans/` and clobber floor plan images.
/plans/
/progress/
/specs/
/thoughts/
/.planning/

# Local development artifacts
.playwright-mcp/
*.log
node_modules/
.tmp/
tmp/

# Old screenshots / dev snapshots in repo root
# Leading slash anchors these to the deploy root only — img/**/*.jpg is unaffected.
/*.png
/*.jpg
/*.jpeg
/*.bak
/audit.md
/ig-*.yml
/text*.txt

# Experimental versions
index-v*.html
index-v*.bak

# Image source originals
img/plans/_orig/
img/plans/commercial/_pdf-source/
img/plans/commercial/_manifest.json

# Deploy artifacts (don't deploy themselves)
deploy.sh
.deployignore
.deploy-env
.deploy-env.example
.env
.env.*

# Documentation (not user-facing)
README.md
CLAUDE.md
icons/README.md

# Example configs only useful for devs
api/config.example.php

# Local rate-limit cache + log
logs/rate/
logs/submissions.log

# Misc
**/*.swp
**/*.swo
